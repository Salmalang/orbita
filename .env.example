# Copy to .env and fill in. NEVER commit .env.
# Free testnet account: https://portal.hedera.com
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=
# Leave empty on first run: a topic is created and its ID printed.
HEDERA_TOPIC_ID=

# Backend
AEROGUARD_DB_URL=sqlite:///./aeroguard.db
AEROGUARD_SIM_SPEED=60
