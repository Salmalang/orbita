# Copy to .env and fill in. NEVER commit .env.
# Free testnet account: https://portal.hedera.com
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
# DER-encoded or hex private key of the testnet account. Keep it only in your local .env.
HEDERA_PRIVATE_KEY=
# Leave empty on first run: a topic is created and its ID printed.
HEDERA_TOPIC_ID=

# Optional: database file used by the ARGOS backend (default data/aeroguard.db)
# AEROGUARD_DB=data/aeroguard.db
